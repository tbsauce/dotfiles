#!/usr/bin/env bash
# Rofi power/session menu with Nerd Font icons

LOCK="󰌾"
LOGOUT="󰍃"
SUSPEND="󰤄"
REBOOT="󰜉"
SHUTDOWN="󰐥"

chosen=$(printf "%s\n%s\n%s\n%s\n%s" "$LOCK" "$LOGOUT" "$SUSPEND" "$REBOOT" "$SHUTDOWN" | \
    rofi -dmenu -theme catppuccin-powermenu -p "Power" -selected-row 0)

[ -z "$chosen" ] && exit 0

confirm_action() {
    local ans
    ans=$(printf "󰅖\n󰄬" | \
        rofi -dmenu -theme catppuccin-confirm -p "Confirm" -mesg "Are you sure?")
    [ "$ans" = "󰄬" ]
}

case "$chosen" in
    "$LOCK")
        ~/.local/bin/lockscreen
        ;;
    "$LOGOUT")
        confirm_action && i3-msg exit
        ;;
    "$SUSPEND")
        confirm_action && systemctl suspend
        ;;
    "$REBOOT")
        confirm_action && systemctl reboot
        ;;
    "$SHUTDOWN")
        confirm_action && systemctl poweroff
        ;;
esac

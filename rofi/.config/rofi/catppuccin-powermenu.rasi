/* Palette comes from colors.rasi — a generated symlink ->
   colors-macchiato.rasi | colors-latte.rasi. Switch: theme light|dark|toggle */
@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 26";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    width: 520px;
    border: 2px;
    border-color: @border-col;
    background-color: @bg-col;
    border-radius: 8px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    enabled: false;
}

listview {
    columns: 5;
    lines: 1;
    spacing: 16px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;
    background-color: @bg-col;
}

element {
    padding: 22px 0px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 12px;
    orientation: vertical;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    expand: true;
    background-color: inherit;
    text-color: inherit;
}

element selected {
    background-color: @selected-col;
    text-color: @blue;
    border: 2px;
    border-color: @blue;
    border-radius: 12px;
}

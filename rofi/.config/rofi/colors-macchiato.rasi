/* Catppuccin Macchiato — rofi palette (imported by the theme files; swapped by `theme`) */
configuration {
    icon-theme: "Papirus-Dark";
}

* {
    bg-col:       #24273a;
    bg-col-light: #363a4f;
    border-col:   #8aadf4;
    selected-col: #363a4f;
    blue:         #8aadf4;
    fg-col:       #cad3f5;
    fg-col2:      #ed8796;
    grey:         #6e738d;
}
